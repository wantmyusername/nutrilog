RewriteEngine On
# Subcarpeta de despliegue (cámbialo si mueves el sitio a otra ruta).
RewriteBase /nutriologa/

# La API PHP maneja sus propias rutas.
RewriteRule ^api/ - [L]

# No reescribir archivos o carpetas existentes.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Fallback de la SPA (React Router).
RewriteRule ^ index.html [L]
